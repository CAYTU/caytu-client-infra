# Copy to secrets.env (gitignored) and fill in.

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong

JWT_SECRET=change-me-32-plus-bytes
RECORDER_CALLBACK_SECRET=change-me-32-plus-bytes
CALLBACK_SHARED_SECRET=change-me-32-plus-bytes
SIGNALING_AUTH_TOKEN=change-me
# TURN_SECRET is not needed — KVS handles TURN.

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP
EMAIL_USER=
EMAIL_PASSWORD=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- AWS-managed messaging ---------------------------------------------------
# Get these from `terraform output` in terraform/aws/managed-cluster/
AWS_REGION=us-east-1
AWS_IOT_ENDPOINT=
AWS_IOT_ROLE_ALIAS=

# Required by caytu-ecr-refresh Job/CronJob to mint a docker-registry Secret
# from Caytu's platform, so kubelet can pull from 688544396352.dkr.ecr.us-east-1
# without a long-lived AWS key on the cluster. Both come from your host's
# enrolment; see docs/self-managed-k8s.md or ask your Caytu contact.
CAYTU_METERING_TOKEN=
CAYTU_PLATFORM_URL=

# The public host the browser reaches this cluster on — must match the ingress
# host and the ACM cert. The frontend renders it into a runtime config script
# every page reads; without it the SSR falls back to http://localhost:5000 and
# the shipped HTML never talks to its own backend.
# The Provision-cluster.yml workflow overwrites this to ${SUBDOMAIN}.caytu.link
# when it generates the file; only relevant when applying by hand.
CAYTU_DOMAIN=caytu.example.com

# SMTP is what the backend uses for the first-admin setup email and every
# invite. Without it the invite endpoint returns 500 and admins created here
# never receive their set-password link. EMAIL_PASSWORD lands in the encrypted
# store separately (from the Caytu-managed defaults, if enrolled; from
# SystemSettings otherwise).
#
# Set these to your own SMTP provider when applying by hand; the
# Provision-cluster.yml workflow fills them from the CAYTU_SMTP_* GitHub
# secrets for Caytu-managed clusters.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=no-reply@example.com
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Caytu
