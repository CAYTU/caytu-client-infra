# Copy to secrets.env (gitignored) and fill in.

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong

JWT_SECRET=change-me-32-plus-bytes
TURN_SECRET=change-me-32-plus-bytes
RECORDER_CALLBACK_SECRET=change-me-32-plus-bytes
CALLBACK_SHARED_SECRET=change-me-32-plus-bytes
SIGNALING_AUTH_TOKEN=change-me

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP
EMAIL_USER=
EMAIL_PASSWORD=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# GCP has no equivalent to AWS_IOT_ENDPOINT / AWS_IOT_ROLE_ALIAS — signaling
# and MQTT are self-hosted in the cluster.
