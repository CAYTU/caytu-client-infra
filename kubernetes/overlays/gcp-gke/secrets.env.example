# Copy to secrets.env (gitignored) and fill in.

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong

JWT_SECRET=change-me-32-plus-bytes
TURN_SECRET=change-me-32-plus-bytes
RECORDER_CALLBACK_SECRET=change-me-32-plus-bytes
CALLBACK_SHARED_SECRET=change-me-32-plus-bytes
SIGNALING_AUTH_TOKEN=change-me

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP
EMAIL_USER=
EMAIL_PASSWORD=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# GCP has no equivalent to AWS_IOT_ENDPOINT / AWS_IOT_ROLE_ALIAS — signaling
# and MQTT are self-hosted in the cluster.

# Required by caytu-ecr-refresh Job/CronJob to mint a docker-registry Secret
# from Caytu's platform, so kubelet can pull from 688544396352.dkr.ecr.us-east-1
# without a long-lived AWS key on the cluster. Both come from your host's
# enrolment; see docs/self-managed-k8s.md or ask your Caytu contact.
CAYTU_METERING_TOKEN=
CAYTU_PLATFORM_URL=

# The public host the browser reaches this cluster on — must match the ingress
# host and the ManagedCertificate domain. The frontend renders it into a
# runtime config script every page reads; without it the SSR falls back to
# http://localhost:5000 and the shipped HTML never talks to its own backend.
CAYTU_DOMAIN=caytu.example.com

# SMTP for the first-admin setup email and every invite. Without it those
# endpoints return 500. EMAIL_PASSWORD is delivered separately (from the
# Caytu-managed defaults, if enrolled; from the Space UI otherwise).
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=no-reply@example.com
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Caytu
