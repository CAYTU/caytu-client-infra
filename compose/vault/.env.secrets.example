# Template for the plaintext input to encrypt-secrets.sh (lives in the
# caytu-client app repo). Copy to .env.secrets, fill in real values, then:
#
#   # 1) Encrypt (run from the caytu-client repo, or wherever encrypt-secrets.sh
#   #    lives — it produces vault.json without touching this deployment):
#   SECRET_STORE_KEY_B64=<same shard as CAYTU_SECRET_STORE_KEY in .env.<target>> \
#   CUSTOMER_ID=<your customer id> \
#     ./encrypt-secrets.sh --input .env.secrets --out vault.json
#
#   # 2) Seed the encrypted blob into the backend's Mongo vault:
#   caytu-client -t <target> secrets seed --in vault.json
#
# Both files (.env.secrets AND vault.json) are gitignored — encrypted or not, a
# secret blob does not belong in git. This .example is the only committed one.
#
# Format:
#   KEY=value                    # inline single-line value
#   KEY@file=/path               # file CONTENTS become the value (PEM, JSON, …)
#   AWS_IOT_CERT_PATH=/path      # file-shaped: the cert file is sealed as a blob
#   AWS_IOT_KEY_PATH=/path       # file-shaped: the private key is sealed as a blob
#   AWS_IOT_CA_PATH=/path        # file-shaped: the CA is sealed as a blob
#
# Blank values are OMITTED from the encrypted output — leave a line empty to
# say "not applicable to this deployment" rather than sealing an empty string.

# --- Infra / integrations ----------------------------------------------------
# Outbound mail — used for the initial-admin setup email and later password
# resets. See docs/on-premise.md § "The initial admin email".
EMAIL_PASSWORD=

# MinIO admin credentials. The bucket-scoped API keys are separate — these are
# the ROOT credentials used by the backend to mint short-lived presigned URLs.
# Must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in .env.<target>.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Shared bearer token every peer (backend, gstreamer, browser) presents to the
# signaling server. Must match SIGNALING_AUTH_TOKEN in .env.<target> AND the
# key in compose/secrets/signaling-tokens.json.
SIGNALING_AUTH_TOKEN=

# TURN long-term-credential secret. Must match TURN_SECRET in .env.<target>
# AND the value coturn is configured with in compose/coturn.conf.
TURN_SECRET=

# HMAC secret gstreamer uses to sign the recording-complete callback to the
# backend. Generate with `openssl rand -hex 32`.
RECORDER_CALLBACK_SECRET=

# Key that encrypts SMS provider credentials at rest. REQUIRED — the backend
# fails closed if this is missing. Generate with `openssl rand -hex 32`.
SMS_ENCRYPTION_KEY=

# Talks to the Caytu billing/licensing platform. Empty means this deployment
# reports no usage. `caytu-client instance provision` writes this for you.
CAYTU_PLATFORM_API_KEY=

# --- Firebase (mobile push notifications) ------------------------------------
# Leave blank if you don't ship the mobile companion app.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The PEM value — either paste it inline (escape \n) or use the @file form:
#   FIREBASE_PRIVATE_KEY@file=/absolute/path/to/private-key.pem
FIREBASE_PRIVATE_KEY=

# --- LLM providers (optional — leave blank to disable that provider) ---------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VLLM_API_KEY=

# --- AWS IoT device credentials (aws-* targets ONLY — omit on on-prem) -------
# The certificate, private key and CA used to talk to AWS IoT Core / KVS.
# Sealed as file blobs; the backend materialises them to tmpfs at boot. Leave
# these commented out on on-prem — the local mqtt-broker is used instead.
#AWS_IOT_CERT_PATH=/absolute/path/to/device-cert.pem
#AWS_IOT_KEY_PATH=/absolute/path/to/device-private.key
#AWS_IOT_CA_PATH=/absolute/path/to/AmazonRootCA1.pem
