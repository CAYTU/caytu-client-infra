# =============================================================================
# caytu-client — unified environment template
#
# Copy this file into one of:
#   .env.local       — laptop / local development stack
#   .env.remote      — single-instance remote (any SSH host, AWS EC2, GCP GCE)
# The CLI (`caytu-client`) reads .env.<target> based on the active target.
#
# Only settings below are read by docker compose. Per-service secrets live in
# .env.backend, .env.frontend, .env.streamer, .env.signaling, .env.gstreamer,
# which are passed to the individual containers via env_file. Keep those files
# outside git.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment identity
# -----------------------------------------------------------------------------
CAYTU_ENV=local                       # local | remote | staging | prod
CAYTU_PROJECT_TAG=caytu-client
TZ=UTC

# -----------------------------------------------------------------------------
# Image sourcing
#
# For local dev, leave IMAGE_REGISTRY empty — the local overlay builds images
# tagged caytu-client/<svc>:local from the caytu-client repo.
#
# For remote/prod, set both to point at your registry, e.g.:
#   IMAGE_REGISTRY=688544396352.dkr.ecr.us-east-1.amazonaws.com
#   IMAGE_TAG=latest-arm64
# You can override any single service via BACKEND_IMAGE_TAG, FRONTEND_IMAGE_TAG,
# SIGNALING_IMAGE_TAG, GSTREAMER_IMAGE_TAG, MQTT_STREAMER_IMAGE_TAG.
# -----------------------------------------------------------------------------
IMAGE_REGISTRY=
IMAGE_TAG=latest
# BACKEND_IMAGE_TAG=
# FRONTEND_IMAGE_TAG=
# SIGNALING_IMAGE_TAG=
# GSTREAMER_IMAGE_TAG=
# MQTT_STREAMER_IMAGE_TAG=

# Where the caytu-client source tree lives, so the local overlay can bind-mount
# and build from it.
CAYTU_CLIENT_REPO=../../caytu-client

# -----------------------------------------------------------------------------
# Service versions (pinned per image)
# -----------------------------------------------------------------------------
MONGO_VERSION=8.2
MONGOT_VERSION=latest
REDIS_VERSION=7-alpine
MINIO_VERSION=latest
MC_VERSION=latest
COTURN_VERSION=latest
VAULT_VERSION=latest
NGINX_VERSION=alpine
CERTBOT_VERSION=latest
PROMETHEUS_VERSION=latest
GRAFANA_VERSION=latest
CADVISOR_VERSION=v0.49.1
NODE_EXPORTER_VERSION=latest
DOZZLE_VERSION=latest

# -----------------------------------------------------------------------------
# Data plane
# -----------------------------------------------------------------------------
MONGO_DATABASE=caytu
# Set this to enable the mongot vector-search sidecar (also start with
# `--profile search`). Requires SCRAM auth wiring on mongod.
# MONGOT_ARGS=--setParameter mongotHost=mongot:27027 --setParameter searchIndexManagementHostAndPort=mongot:27027

REDIS_APPENDONLY=no
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BROWSER_REDIRECT_URL=
MINIO_PUBLIC_URL=http://localhost:9000

# -----------------------------------------------------------------------------
# Host port publishing (local overlay only)
# -----------------------------------------------------------------------------
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
BACKEND_HOST_PORT=5000
FRONTEND_HOST_PORT=3000
SIGNALING_HOST_PORT=3001
GSTREAMER_HOST_PORT=8080
MQTT_STREAMER_HOST_PORT=8100
VAULT_HOST_PORT=8200

# -----------------------------------------------------------------------------
# Streaming / WebRTC
#
# Default per target (auto-picked by the CLI):
#   local, onprem, ssh, gcp-*   →  STREAMING_PROVIDER=self-hosted
#                                  (signaling-server + coturn in the stack)
#   aws-single, aws-cluster     →  STREAMING_PROVIDER=kvs
#                                  (AWS IoT Core for MQTT, KVS for WebRTC signaling,
#                                   KVS ICE endpoints for STUN/TURN — no self-hosted
#                                   signaling/turn services run)
#
# You can override by setting COMPOSE_PROFILES and STREAMING_PROVIDER below.
# -----------------------------------------------------------------------------
STREAMING_PROVIDER=self-hosted        # self-hosted | kvs
SIGNALING_AUTH_DRIVER=token           # allow-all (dev) | token
SIGNALING_AUTH_TOKEN=
SIGNALING_SERVER_INTERNAL_URL=http://signaling-server:3001
SIGNALING_SERVER_PUBLIC_URL=
SIGNALING_SERVER_PUBLIC_WS_URL=

STUN_URLS=stun:coturn:3478
TURN_URLS=turn:coturn:3478
TURN_SECRET=caytu-turn-secret-key-change-me

# -----------------------------------------------------------------------------
# Compose profiles — controls which optional services start.
#
# Leave empty to accept the CLI's per-target default (see caytu-client script:
# default_profiles_for). Set explicitly to override, comma-separated:
#   self-hosted   signaling-server + coturn
#   turn          coturn only
#   search        mongot vector-search sidecar
#   vault         hashicorp vault (dev mode)
#   mqtt-broker   local mosquitto broker
# -----------------------------------------------------------------------------
# COMPOSE_PROFILES=self-hosted,turn

# -----------------------------------------------------------------------------
# AWS-managed messaging (used when STREAMING_PROVIDER=kvs on aws-* targets)
#
# Set these in .env.aws-single or .env.aws-cluster. They plug into IoT Core for
# MQTT and KVS WebRTC for signaling. Cert files live at ${BACKEND_CERTS_DIR}
# (bind-mounted read-only by backend + gstreamer-recorder in the remote overlay).
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_IOT_ENDPOINT=
AWS_IOT_ROLE_ALIAS=
# KVS channel / signaling — actual values come from the app's per-channel config
KVS_SIGNALING_CHANNEL_ARN=

# -----------------------------------------------------------------------------
# Application env-file paths (relative to the compose file's directory)
#
# These files hold the actual secrets consumed by each container. Keep them
# outside git; the CLI's `env push` rsyncs them along with .env.
# -----------------------------------------------------------------------------
ENV_BACKEND_FILE=./.env.backend
ENV_FRONTEND_FILE=./.env.frontend
ENV_SIGNALING_FILE=./.env.signaling
ENV_GSTREAMER_FILE=./.env.gstreamer
ENV_STREAMER_FILE=./.env.streamer

# -----------------------------------------------------------------------------
# Remote-only: cert directories on the host that get bind-mounted read-only
# -----------------------------------------------------------------------------
BACKEND_CERTS_DIR=/opt/caytu/backend-certs
MQTT_CERTS_DIR=/opt/caytu/mqtt-certs

# -----------------------------------------------------------------------------
# Nginx / hostname
#
# For public deployments (ssh / aws-single / gcp-single): a real DNS name reachable
# from the internet, used by Let's Encrypt via `caytu-client ssl bootstrap`.
#
# For on-prem: this can be a bare IP (e.g. 10.0.1.42) or a LAN hostname
# (e.g. caytu.local). Use `caytu-client ssl self-signed <host>` to generate a
# cert or `caytu-client ssl http-only` to skip TLS entirely.
# -----------------------------------------------------------------------------
CAYTU_DOMAIN=example.com
CAYTU_LETSENCRYPT_EMAIL=ops@example.com

# -----------------------------------------------------------------------------
# Monitoring overlay
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_HOST_PORT=3005
GRAFANA_BIND=127.0.0.1
PROMETHEUS_HOST_PORT=9095
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_RETENTION_TIME=15d
DOZZLE_HOST_PORT=8005
DOZZLE_BIND=127.0.0.1
DOZZLE_AUTH_PROVIDER=none             # none | simple | forwardproxy
# DOZZLE_USERNAME=admin
# DOZZLE_PASSWORD=

# -----------------------------------------------------------------------------
# Backup overlay
# -----------------------------------------------------------------------------
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_MINIO_BUCKETS=video-recordings knowledge-base profiles blocs dashboard-media kpi-media
# MONGO_BACKUP_USER=
# MONGO_BACKUP_PASSWORD=

# Offsite via restic. Leave RESTIC_REPOSITORY empty to skip the upload step.
# Examples:
#   RESTIC_REPOSITORY=s3:s3.amazonaws.com/caytu-client-backups
#   RESTIC_REPOSITORY=b2:caytu-client-backups:/
#   RESTIC_REPOSITORY=gs:caytu-client-backups:/
#   RESTIC_REPOSITORY=sftp:backup@example.com:/srv/backups/caytu-client
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
RESTIC_AWS_ACCESS_KEY_ID=
RESTIC_AWS_SECRET_ACCESS_KEY=
RESTIC_B2_ACCOUNT_ID=
RESTIC_B2_ACCOUNT_KEY=
RESTIC_GCS_KEYFILE=
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6

# -----------------------------------------------------------------------------
# Local dev conveniences
# -----------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@caytu.local
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
LOG_LEVEL=info
