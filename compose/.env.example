# =============================================================================
# caytu-client — unified environment template
#
# Copy this file into one of:
#   .env.local       — laptop / local development stack
#   .env.remote      — single-instance remote (any SSH host, AWS EC2, GCP GCE)
# The CLI (`caytu-client`) reads .env.<target> based on the active target.
#
# This is the ONLY env file. It serves two purposes at once:
#   1. ${VAR} substitution in the compose files (via --env-file)
#   2. the environment inside every container (each service does env_file: ./.env,
#      which the CLI symlinks to the active .env.<target>)
#
# Because it is shared, every variable here reaches every container — the
# frontend sees MINIO_ROOT_PASSWORD and TURN_SECRET too. That matches production;
# put anything that must not be that widely visible in the encrypted Mongo secret
# store instead (see docs/secrets.md).
#
# Keep this file out of git.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment identity
# -----------------------------------------------------------------------------
CAYTU_ENV=local                       # local | remote | staging | prod
CAYTU_PROJECT_TAG=caytu-client
TZ=UTC

# -----------------------------------------------------------------------------
# Image sourcing
#
# For local dev, leave IMAGE_REGISTRY empty — the local overlay builds images
# tagged caytu-client/<svc>:local from the caytu-client repo.
#
# For remote/prod, set both to point at your registry, e.g.:
#   IMAGE_REGISTRY=688544396352.dkr.ecr.us-east-1.amazonaws.com
#   IMAGE_TAG=latest-arm64
# You can override any single service's tag via BACKEND_IMAGE_TAG,
# FRONTEND_IMAGE_TAG, SIGNALING_IMAGE_TAG, GSTREAMER_IMAGE_TAG,
# MQTT_STREAMER_IMAGE_TAG.
#
# The repository name defaults to the service's own name, which does not match
# what caytu-client's CI actually pushes. For the Caytu ECR account, uncomment
# the *_IMAGE_NAME block below or nothing will resolve.
# -----------------------------------------------------------------------------
IMAGE_REGISTRY=
IMAGE_TAG=latest
# BACKEND_IMAGE_TAG=
# FRONTEND_IMAGE_TAG=
# SIGNALING_IMAGE_TAG=
# GSTREAMER_IMAGE_TAG=
# MQTT_STREAMER_IMAGE_TAG=

# Repository names as they exist in the Caytu ECR account.
# BACKEND_IMAGE_NAME=caytu-client-backend
# FRONTEND_IMAGE_NAME=caytu-client-frontend
# SIGNALING_IMAGE_NAME=caytu-client-signaling-server
# GSTREAMER_IMAGE_NAME=caytu-client-gstreamer-recorder
# MQTT_STREAMER_IMAGE_NAME=caytu-client-mqtt-streamer

# Where the caytu-client source tree lives, so the local overlay can bind-mount
# and build from it.
CAYTU_CLIENT_REPO=../../caytu-client

# Build-time only: the backend depends on @caytu/metering from private
# CodeArtifact. Refresh with `caytu-client codeartifact-login`; it expires every
# 12 hours. Not needed when pulling prebuilt images.
CODEARTIFACT_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Usage metering to the Caytu platform
#
# The token is this organization's API key (ct_live_… / ct_test_…), minted at
# POST /api/auth/tokens on the platform. It decides which org the usage belongs
# to, so the client can only ever bill its own organization and this is a
# server-side secret.
#
# Metering stays off until a token is set: a client with no key reports nothing.
# CAYTU_BILLINGS_URL points at the platform, e.g. https://caytu.link.
# -----------------------------------------------------------------------------
CAYTU_METERING_TOKEN=
CAYTU_BILLINGS_URL=https://caytu.link
CAYTU_METERING_SOURCE=caytu-client

# Where `license fetch` asks for a license. Behind one gateway this is the same
# host as CAYTU_BILLINGS_URL and can be left empty; set it when billings and
# licenses are reachable at different addresses, as they are in local dev.
CAYTU_PLATFORM_URL=

# How THIS MACHINE reaches the platform, for CLI verbs (`instance provision`,
# `license fetch`). The variables above are what the container uses, and in local
# development those are docker service names that do not resolve on the host.
# In production both are the same public gateway and this can stay empty.
PLATFORM_HOST_URL=

# Local development only: the docker network of a Caytu platform running on this
# same machine (usually "caytu"). Setting it layers docker-compose.local-platform.yml
# so the client can reach billings and licenses by service name. Leave empty when
# the platform is remote, or when there isn't one.
CAYTU_PLATFORM_NETWORK=

# This deployment's organization on the platform. Used by `license fetch` to ask
# for a license; the platform still decides from the token whether the caller
# may act for that org.
CAYTU_ORGANIZATION_ID=

# -----------------------------------------------------------------------------
# Licensing (see `caytu-client license --help`)
#
# The client's own license endpoints are gated on ITS admin role, not on the
# platform token, so `license install` and `license status` need a client
# account. Leave these empty and pass `--auth <bearer>` instead if you would
# rather not keep a password in the env file.
# -----------------------------------------------------------------------------
CLIENT_BACKEND_URL=
CLIENT_ADMIN_EMAIL=
CLIENT_ADMIN_PASSWORD=

# The Ed25519 PUBLIC key the client verifies licenses with. It must be the
# public half of the platform's KMS signing key, or every license is rejected
# with "signature verification failed".
#
# Production images bake it at build time from the LICENSE_PUBLIC_KEY_B64 build
# arg, so this is normally only needed for dev images, which have none and answer
# 503 to an install. PEM with literal \n, or standard base64 of the raw 32 bytes.
LICENSE_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Service versions (pinned per image)
# -----------------------------------------------------------------------------
MONGO_VERSION=8.2
MONGOT_VERSION=latest
REDIS_VERSION=7-alpine
MINIO_VERSION=latest
MC_VERSION=latest
COTURN_VERSION=latest
VAULT_VERSION=latest
NGINX_VERSION=alpine
CERTBOT_VERSION=latest
PROMETHEUS_VERSION=latest
GRAFANA_VERSION=latest
CADVISOR_VERSION=v0.49.1
NODE_EXPORTER_VERSION=latest
DOZZLE_VERSION=latest

# -----------------------------------------------------------------------------
# Data plane
# -----------------------------------------------------------------------------
MONGO_DATABASE=caytu
# Set this to enable the mongot vector-search sidecar (also start with
# `--profile search`). Requires SCRAM auth wiring on mongod.
# MONGOT_ARGS=--setParameter mongotHost=mongot:27027 --setParameter searchIndexManagementHostAndPort=mongot:27027

REDIS_APPENDONLY=no
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BROWSER_REDIRECT_URL=
# Leave empty locally: presigned URLs follow MINIO_HOST_PORT below. Set it only
# where MinIO is reached by a name of its own.
MINIO_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Host port publishing (local overlay only)
#
# Deliberately clear of the Caytu platform's local ports (3000 web, 5000, 6379,
# 9000/9001, 27017, 8080) and its monitoring (9100 node-exporter): the two stacks are meant to run side by side on one
# machine. `up` refuses rather than starting a stack that would collide, and
# names the variable to change.
# -----------------------------------------------------------------------------
MONGO_HOST_PORT=27117
REDIS_HOST_PORT=6479
MINIO_HOST_PORT=9400
MINIO_CONSOLE_HOST_PORT=9401
BACKEND_HOST_PORT=5100
FRONTEND_HOST_PORT=3100
SIGNALING_HOST_PORT=3101
GSTREAMER_HOST_PORT=8180
MQTT_STREAMER_HOST_PORT=8100
MQTT_BROKER_HOST_PORT=1885
VAULT_HOST_PORT=8300

# mqtt-streamer picks its config source with USE_MONGO_CONFIG. Default is
# "true" — the streamer reads the active StreamerConfig document from MongoDB
# and, if none is found, falls back to compose/mqtt-streamer/streamer_config.yaml
# (seeded by the CLI on first `up`, pointing at the in-stack `mqtt-broker`).
# Set to "false" to skip Mongo entirely and always use the YAML.
USE_MONGO_CONFIG=true
MONGO_CONFIG_NAME=main

# -----------------------------------------------------------------------------
# Streaming / WebRTC
#
# Default per target (auto-picked by the CLI):
#   local, onprem, ssh, gcp-*   →  STREAMING_PROVIDER=self-hosted
#                                  (signaling-server + coturn in the stack)
#   aws-single, aws-cluster     →  STREAMING_PROVIDER=kvs
#                                  (AWS IoT Core for MQTT, KVS for WebRTC signaling,
#                                   KVS ICE endpoints for STUN/TURN — no self-hosted
#                                   signaling/turn services run)
#
# You can override by setting COMPOSE_PROFILES and STREAMING_PROVIDER below.
# -----------------------------------------------------------------------------
STREAMING_PROVIDER=self-hosted        # self-hosted | kvs

# SIGNALING_AUTH_DRIVER picks how signaling-server validates the token that
# backend / gstreamer / the browser present on every connection. Valid values:
#
#   static  (default, recommended for on-prem)
#           Backend, gstreamer and the browser all send SIGNALING_AUTH_TOKEN
#           verbatim as a shared bearer token. The signaling server looks it up
#           in compose/secrets/signaling-tokens.json (mounted read-only into
#           the container). Copy signaling-tokens.example.json, replace the
#           placeholder key with the value of SIGNALING_AUTH_TOKEN below, and
#           put a strong random string in both places:
#               openssl rand -hex 32
#
#   jwt     Signaling verifies the token as a JWT signed with JWT_SECRET.
#           Not currently used by any peer — backend hands out the raw shared
#           token, not a signed JWT. Only pick this if you also change how
#           tokens are minted upstream.
#
#   vault   Signaling calls Vault to look up the presented token. Requires a
#           running Vault (not dev mode), a `webrtc-access` policy, and every
#           peer to present a valid Vault token. Heavier than static; only
#           worth it if you already run Vault in production.
#
# allow-all exists for local development and is refused when NODE_ENV=production.
SIGNALING_AUTH_DRIVER=static
SIGNALING_AUTH_TOKEN=
SIGNALING_SERVER_INTERNAL_URL=http://signaling-server:3001
SIGNALING_SERVER_PUBLIC_URL=
SIGNALING_SERVER_PUBLIC_WS_URL=

STUN_URLS=stun:coturn:3478
TURN_URLS=turn:coturn:3478
TURN_SECRET=caytu-turn-secret-key-change-me

# The IP coturn advertises to peers during ICE. Without this, coturn hands
# out its docker-bridge IP (172.x.x.x) which no browser can reach. Leave
# empty to fall back to CAYTU_DOMAIN — set explicitly only when CAYTU_DOMAIN
# is a hostname (turnserver's --external-ip wants an IP address, not a name).
COTURN_EXTERNAL_IP=

# -----------------------------------------------------------------------------
# Compose profiles — controls which optional services start.
#
# Leave empty to accept the CLI's per-target default (see caytu-client script:
# default_profiles_for). Set explicitly to override, comma-separated:
#   self-hosted   signaling-server + coturn
#   turn          coturn only
#   search        mongot vector-search sidecar
#   vault         hashicorp vault (dev mode)
#   mqtt-broker   local mosquitto broker
# -----------------------------------------------------------------------------
# COMPOSE_PROFILES=self-hosted,turn

# -----------------------------------------------------------------------------
# AWS-managed messaging (used when STREAMING_PROVIDER=kvs on aws-* targets)
#
# Set these in .env.aws-single or .env.aws-cluster. They plug into IoT Core for
# MQTT and KVS WebRTC for signaling. The IoT device cert, private key and CA are
# NOT files — they live in the encrypted caytu_secrets store in Mongo, loaded via
# `caytu-client secrets seed`. See docs/secrets.md.
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_IOT_ENDPOINT=
AWS_IOT_ROLE_ALIAS=
# KVS channel / signaling — actual values come from the app's per-channel config
KVS_SIGNALING_CHANNEL_ARN=

# -----------------------------------------------------------------------------
# Nginx / hostname
#
# For public deployments (ssh / aws-single / gcp-single): a real DNS name reachable
# from the internet, used by Let's Encrypt via `caytu-client ssl bootstrap`.
#
# For on-prem: this can be a bare IP (e.g. 10.0.1.42) or a LAN hostname
# (e.g. caytu.local). Use `caytu-client ssl self-signed <host>` to generate a
# cert or `caytu-client ssl http-only` to skip TLS entirely.
# -----------------------------------------------------------------------------
CAYTU_DOMAIN=example.com
CAYTU_LETSENCRYPT_EMAIL=ops@example.com

# -----------------------------------------------------------------------------
# Monitoring overlay
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_HOST_PORT=3005
GRAFANA_BIND=127.0.0.1
PROMETHEUS_HOST_PORT=9095
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_RETENTION_TIME=15d
DOZZLE_HOST_PORT=8005
DOZZLE_BIND=127.0.0.1
DOZZLE_AUTH_PROVIDER=none             # none | simple | forwardproxy
# DOZZLE_USERNAME=admin
# DOZZLE_PASSWORD=

# -----------------------------------------------------------------------------
# Backup overlay
# -----------------------------------------------------------------------------
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_MINIO_BUCKETS=video-recordings knowledge-base profiles blocs dashboard-media kpi-media
# MONGO_BACKUP_USER=
# MONGO_BACKUP_PASSWORD=

# Offsite via restic. Leave RESTIC_REPOSITORY empty to skip the upload step.
# Examples:
#   RESTIC_REPOSITORY=s3:s3.amazonaws.com/caytu-client-backups
#   RESTIC_REPOSITORY=b2:caytu-client-backups:/
#   RESTIC_REPOSITORY=gs:caytu-client-backups:/
#   RESTIC_REPOSITORY=sftp:backup@example.com:/srv/backups/caytu-client
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
RESTIC_AWS_ACCESS_KEY_ID=
RESTIC_AWS_SECRET_ACCESS_KEY=
RESTIC_B2_ACCOUNT_ID=
RESTIC_B2_ACCOUNT_KEY=
RESTIC_GCS_KEYFILE=
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6

# -----------------------------------------------------------------------------
# Addresses
#
# Leave these empty. Locally they follow the published ports above, so moving a
# port cannot leave a URL pointing at the old one. Set CAYTU_DEPLOYMENT_URL only
# where people reach this deployment by a name we cannot work out.
# -----------------------------------------------------------------------------
CAYTU_DEPLOYMENT_URL=
CLIENT_URL=
CORS_ORIGIN=
NEXT_PUBLIC_API_URL=

# -----------------------------------------------------------------------------
# Cryptographic secrets that live in this file
#
# The backend and its peers keep MOST secrets in the encrypted Mongo store (see
# compose/vault/.env.secrets.example). These are the exceptions — the backend
# reads them straight from process.env at boot and fails closed if empty, so
# they cannot sit in the vault.
#
#   JWT_SECRET     Signs and verifies every session, refresh token, and reset
#                  link. Required and fail-closed at boot: the backend throws
#                  "JWT_SECRET is not set (required for token signing/
#                  verification)" and exits if this is empty. Generate with:
#                    openssl rand -hex 64
#                  `caytu-client instance provision` writes one for you when
#                  the .env file has none; set your own only if you want to
#                  pin a specific value across re-provisions.
#
#   CAYTU_SECRET_STORE_KEY  base64 shard used to derive the AES key for the
#                  encrypted vault. Distributed images bake this in at build
#                  time and IGNORE the runtime env — set it only for local
#                  builds. Must match SECRET_STORE_KEY_B64 passed to
#                  encrypt-secrets.sh when sealing your vault.json.
# -----------------------------------------------------------------------------
JWT_SECRET=
CAYTU_SECRET_STORE_KEY=

# -----------------------------------------------------------------------------
# Administrator
#
# Nothing to fill in. The administrator is named on the platform's instance
# record; `instance provision` writes it here. Empty means this deployment has
# no administrator yet, and the stack will not invent one.
# -----------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=

# -----------------------------------------------------------------------------
# Outbound email (SMTP)
#
# Used for the initial-admin setup email (the "set your password" link sent to
# INITIAL_ADMIN_EMAIL on first boot when the DB has zero users), password
# resets, and any other transactional mail.
#
# Two ways to configure:
#   - SystemSettings.emailProvider set via the Space admin UI. Wins when
#     enabled, but you can only reach the UI *after* signing in — no help for
#     the very first setup email.
#   - The EMAIL_* env vars below. Fallback used on a fresh install; also the
#     only path if the SystemSettings row is disabled.
#
# EMAIL_PASSWORD is NOT read from this file — it lives in the encrypted secret
# store in Mongo. Add it to compose/vault/.env.secrets (see the .example there
# for the template), encrypt to vault.json, then seed:
#   caytu-client -t <target> secrets seed --in compose/vault/vault.json
#
# Leave everything empty to disable outbound mail. When disabled, the initial
# superAdmin is still created but the setup link is only printed in the
# backend logs. Grep for it: `docker compose logs backend | grep set-password`.
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false                    # true for implicit TLS (465), false for STARTTLS (587)
EMAIL_USER=no-reply@caytu.com
EMAIL_FROM=no-reply@caytu.com
EMAIL_FROM_NAME=Caytu Client
# EMAIL_PASSWORD is seeded into the encrypted secret store — see comment above.

LOG_LEVEL=info
