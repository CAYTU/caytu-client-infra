# Deployment state (per-operator)
.caytu-client-state.json

# Secrets — every .env* except the committed template
compose/.env
compose/.env.*
!compose/.env.example

# Runtime data on operator laptops
compose/backups/
compose/certbot/conf/
compose/certbot/www/
compose/secrets/*
!compose/secrets/.gitkeep
!compose/secrets/signaling-tokens.example.json

# mqtt-streamer per-operator config (holds the ingest API token and device
# fleet). Only the .example template is committed.
compose/mqtt-streamer/streamer_config.yaml

# Secret-store inputs and outputs. `.env.secrets` is the plaintext values fed
# into encrypt-secrets.sh; `vault*.json` is the encrypted blob it produces.
# Neither belongs in git — encrypted or not, a secret blob is still a secret.
compose/vault/.env.secrets
compose/vault/vault*.json
vault*.json
*.vault.json
!compose/vault/.env.secrets.example

# Terraform (added in phases 2-5)
**/.terraform/
**/.terraform.lock.hcl
**/terraform.tfstate
**/terraform.tfstate.backup
# Terraform names a migration backup terraform.tfstate.<epoch>.backup, which
# the line above does not match. Five of them were committed before this.
**/terraform.tfstate.*.backup
**/*.tfvars
!**/example.tfvars

# Kubernetes state / kubeconfigs
**/kubeconfig
**/*.kubeconfig

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# The agent saves the TLS config here while it serves plain HTTP.
compose/nginx/conf.d/default.conf.tls
